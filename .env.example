# Puerto en el host. Si está ocupado, cambia solo este valor.
LECTOR_PORT=8000

# Límites del servicio.
LECTOR_MAX_FILE_MB=30
LECTOR_MAX_PAGES=300
LECTOR_JOB_TTL=3600
LECTOR_MAX_PASSWORD_ATTEMPTS=5

# Resolución de renderizado de las páginas PDF (más alto = más nítido y pesado).
LECTOR_RENDER_DPI=120
